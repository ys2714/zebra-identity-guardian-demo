<?xml version="1.0" encoding="utf-8"?>
<!--
  Japanese strings.

  Identity Guardian API names and the role strings themselves are left alone:
  the role comes from the SSO provider, so it is shown exactly as Identity
  Guardian reported it.
-->
<resources>
    <string name="app_name">IG Lead</string>

    <!-- Login form -->
    <string name="label_user">ユーザー :</string>
    <string name="label_password">パスワード :</string>
    <string name="label_role">ロール :</string>
    <string name="value_missing">—</string>
    <string name="action_login">ログイン</string>
    <string name="action_exit">終了</string>

    <!-- Role gate -->
    <string name="access_denied_title">このロールでは利用できません</string>
    <string name="access_denied_detail">Identity Guardian のロールは「%1$s」です。このロールでは IG Lead を利用できません。</string>
    <string name="access_denied_user">%1$s でサインインしています。</string>

    <!-- Get Current User Session -->
    <string name="session_loading">Identity Guardian のセッションを読み取っています…</string>
    <string name="session_none">有効な Identity Guardian のセッションがありません。</string>
    <string name="session_failed">セッションを読み取れませんでした: %1$s</string>
    <string name="session_hint">ヒント: %1$s</string>

    <!-- MX AccessMgr + ZDM delegation scopes -->
    <string name="authorization_in_progress">Identity Guardian の呼び出し権限を取得しています…</string>
    <string name="authorization_failed">権限の取得に失敗しました: %1$s</string>
    <string name="action_retry">再試行</string>

    <!-- Login outcome -->
    <string name="login_signed_in">%1$s（%2$s）でログインしました。</string>
    <string name="login_no_user">ログインする Identity Guardian のユーザーがいません。</string>
    <string name="login_password_required">パスワードを入力してください。</string>
</resources>
