# Copy this file to keystore.properties (which is git-ignored) and fill in the
# credentials for the release key. Paths are relative to the project root.
#
# Create the keystore with:
#   keytool -genkeypair -v \
#     -keystore zebra-ig-demo.jks \
#     -alias zebra-ig-demo-key \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Zebra Identity Guardian Demo, O=Zebra, C=US"
storeFile=zebra-ig-demo.jks
storePassword=
keyAlias=zebra-ig-demo-key
keyPassword=
